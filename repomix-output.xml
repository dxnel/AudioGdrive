<file path="server/api/stream.get.ts">
// Proxy audio Drive -> navigateur.
// Le token Google ne quitte JAMAIS le serveur. Le <audio> appelle simplement
//   /api/stream?id=<driveId>            (propriétaire, cookie de session)
//   /api/stream?id=<driveId>&share=<t>  (invité, lien de partage)
// Les requêtes Range sont relayées : indispensable pour le seek et pour Safari.
export default defineEventHandler(async (event) => {
  const id = String(getQuery(event).id || '')
  const { item, ownerId } = await resolveItem(event, id, 'view')
  if (item.is_folder) throw createError({ statusCode: 400, message: 'Ce n\'est pas un fichier' })

  const headers: Record<string, string> = {}
  const range = getHeader(event, 'range')
  if (range) headers.Range = range

  // Coupe le flux Drive si l'auditeur ferme l'onglet / change de morceau
  const abort = new AbortController()
  event.node.req.on('close', () => abort.abort())

  const upstream = await driveFetch(event, ownerId, `/files/${id}?alt=media&supportsAllDrives=true`, {
    headers,
    signal: abort.signal
  })

  if (![200, 206, 416].includes(upstream.status)) {
    throw createError({
      statusCode: upstream.status === 404 ? 404 : 502,
      message: `Lecture Drive impossible (${upstream.status})`
    })
  }

  setResponseStatus(event, upstream.status)

  let type = upstream.headers.get('content-type') || ''
  if (!type || type.startsWith('application/octet-stream')) type = item.mime_type || 'audio/mpeg'
  setHeader(event, 'content-type', type)
  for (const h of ['content-length', 'content-range']) {
    const v = upstream.headers.get(h)
    if (v) setHeader(event, h, v)
  }
  setHeader(event, 'accept-ranges', 'bytes')
  setHeader(event, 'cache-control', 'private, max-age=3600')

  return upstream.body
})
</file>

<file path="server/utils/access.ts">
import type { H3Event } from 'h3'
import { serverSupabaseUser, serverSupabaseServiceRole } from '#supabase/server'

export async function requireUserId(event: H3Event): Promise<string> {
  const user: any = await serverSupabaseUser(event).catch(() => null)
  const id = user?.id ?? user?.sub
  if (!id) throw createError({ statusCode: 401, message: 'Non connecté' })
  return id as string
}

export async function getShare(event: H3Event, token: string) {
  const db = serverSupabaseServiceRole(event)
  const { data } = await db.from('shares').select('*').eq('token', token).eq('revoked', false).maybeSingle()
  if (!data || (data.expires_at && new Date(data.expires_at) < new Date())) {
    throw createError({ statusCode: 404, message: 'Lien de partage invalide ou expiré' })
  }
  return data
}

export type Need = 'view' | 'edit' | 'owner'

// Point d'entrée unique des droits sur un fichier/dossier de l'index.
//  - avec ?share=TOKEN : droits de l'invité (viewer = voir/écouter, editor = + renommer)
//  - sinon : session Supabase du propriétaire
// Un invité ne voit un élément que s'il est DANS le dossier partagé (ou est ce dossier).
export async function resolveItem(event: H3Event, driveId: string, need: Need) {
  assertId(driveId)
  const db = serverSupabaseServiceRole(event)
  const shareToken = getQuery(event).share as string | undefined

  if (shareToken) {
    if (need === 'owner') throw createError({ statusCode: 403, message: 'Réservé au propriétaire' })
    const share = await getShare(event, shareToken)
    if (need === 'edit' && share.role !== 'editor') {
      throw createError({ statusCode: 403, message: 'Ce lien est en lecture seule' })
    }
    const { data } = await db
      .from('library_items')
      .select('*')
      .eq('library_id', share.library_id)
      .eq('drive_id', driveId)
      .limit(1)
    const item = data?.[0]
    if (!item || !(item.drive_id === share.folder_id || item.path_ids.includes(share.folder_id))) {
      throw createError({ statusCode: 404, message: 'Introuvable' })
    }
    return { item, ownerId: share.owner_id as string, isOwner: false }
  }

  const userId = await requireUserId(event)
  const { data } = await db
    .from('library_items')
    .select('*')
    .eq('owner_id', userId)
    .eq('drive_id', driveId)
    .limit(1)
  const item = data?.[0]
  if (!item) throw createError({ statusCode: 404, message: 'Introuvable' })
  return { item, ownerId: userId, isOwner: true }
}
</file>

<file path="server/utils/crypto.ts">
import { createCipheriv, createDecipheriv, randomBytes } from 'node:crypto'

// AES-256-GCM. Format stocké : base64( iv(12) | tag(16) | données )
function getKey(): Buffer {
  const raw = useRuntimeConfig().encryptionKey
  const key = Buffer.from(raw || '', 'base64')
  if (key.length !== 32) {
    throw createError({
      statusCode: 500,
      message: 'NUXT_ENCRYPTION_KEY invalide : génère-la avec `openssl rand -base64 32`'
    })
  }
  return key
}

export function encrypt(text: string): string {
  const iv = randomBytes(12)
  const cipher = createCipheriv('aes-256-gcm', getKey(), iv)
  const enc = Buffer.concat([cipher.update(text, 'utf8'), cipher.final()])
  return Buffer.concat([iv, cipher.getAuthTag(), enc]).toString('base64')
}

export function decrypt(payload: string): string {
  const buf = Buffer.from(payload, 'base64')
  const decipher = createDecipheriv('aes-256-gcm', getKey(), buf.subarray(0, 12))
  decipher.setAuthTag(buf.subarray(12, 28))
  return Buffer.concat([decipher.update(buf.subarray(28)), decipher.final()]).toString('utf8')
}
</file>

<file path="server/utils/google.ts">
import type { H3Event } from 'h3'
import { serverSupabaseServiceRole } from '#supabase/server'

// Cache mémoire des access tokens Google (1 par propriétaire, ~1h de validité)
const tokenCache = new Map<string, { token: string; exp: number }>()

export function forgetToken(ownerId: string) {
  tokenCache.delete(ownerId)
}

// Les ids Drive sont injectés dans des requêtes `q=` : on les valide strictement.
export function assertId(id: unknown): string {
  if (typeof id !== 'string' || !/^[A-Za-z0-9_-]{4,100}$/.test(id)) {
    throw createError({ statusCode: 400, message: 'ID Drive invalide' })
  }
  return id
}

function notConnected() {
  return createError({
    statusCode: 409,
    statusMessage: 'drive_not_connected',
    message: 'Google Drive non connecté : reconnecte-toi avec Google.'
  })
}

export async function getAccessToken(event: H3Event, ownerId: string, force = false): Promise<string> {
  const hit = tokenCache.get(ownerId)
  if (!force && hit && hit.exp > Date.now() + 60_000) return hit.token

  const db = serverSupabaseServiceRole(event)
  const { data } = await db
    .from('drive_connections')
    .select('refresh_token_enc')
    .eq('user_id', ownerId)
    .maybeSingle()
  if (!data) throw notConnected()

  const cfg = useRuntimeConfig()
  const res = await fetch('https://oauth2.googleapis.com/token', {
    method: 'POST',
    headers: { 'content-type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams({
      client_id: cfg.googleClientId,
      client_secret: cfg.googleClientSecret,
      refresh_token: decrypt(data.refresh_token_enc),
      grant_type: 'refresh_token'
    })
  })
  const json: any = await res.json().catch(() => ({}))

  if (!res.ok) {
    tokenCache.delete(ownerId)
    if (json.error === 'invalid_grant') {
      // Token révoqué / expiré : on l'oublie, l'utilisateur doit se reconnecter
      await db.from('drive_connections').delete().eq('user_id', ownerId)
      throw notConnected()
    }
    throw createError({ statusCode: 502, message: `Google OAuth : ${json.error || res.status}` })
  }

  tokenCache.set(ownerId, { token: json.access_token, exp: Date.now() + (json.expires_in ?? 3600) * 1000 })
  return json.access_token
}

// fetch vers l'API Drive v3 avec le token du propriétaire (retry 1x si 401)
export async function driveFetch(
  event: H3Event,
  ownerId: string,
  path: string,
  init: RequestInit = {}
): Promise<Response> {
  const url = path.startsWith('http') ? path : `https://www.googleapis.com/drive/v3${path}`
  const run = async (force: boolean) =>
    fetch(url, {
      ...init,
      headers: { ...(init.headers as Record<string, string>), Authorization: `Bearer ${await getAccessToken(event, ownerId, force)}` }
    })
  let res = await run(false)
  if (res.status === 401) res = await run(true)
  return res
}
</file>

<file path="server/utils/scan.ts">
import type { H3Event } from 'h3'
import { serverSupabaseServiceRole } from '#supabase/server'

const FOLDER = 'application/vnd.google-apps.folder'

async function listChildren(event: H3Event, ownerId: string, folderId: string) {
  const out: any[] = []
  let pageToken: string | undefined
  do {
    const params = new URLSearchParams({
      q: `'${folderId}' in parents and trashed = false and (mimeType = '${FOLDER}' or mimeType contains 'audio/')`,
      fields: 'nextPageToken,files(id,name,mimeType,createdTime,size)',
      pageSize: '1000',
      supportsAllDrives: 'true',
      includeItemsFromAllDrives: 'true'
    })
    if (pageToken) params.set('pageToken', pageToken)
    const res = await driveFetch(event, ownerId, `/files?${params}`)
    if (!res.ok) throw createError({ statusCode: 502, message: `Drive a répondu ${res.status}` })
    const json: any = await res.json()
    out.push(...(json.files || []))
    pageToken = json.nextPageToken
  } while (pageToken)
  return out
}

// Parcourt le dossier racine, garde uniquement les sous-dossiers qui contiennent
// de l'audio (directement ou plus bas) + les fichiers audio, et réécrit l'index.
export async function scanLibrary(event: H3Event, ownerId: string, libraryId: string, rootId: string, rootName: string) {
  const folders = new Map<string, { name: string; parent: string | null; path: string[]; created?: string }>()
  folders.set(rootId, { name: rootName, parent: null, path: [] })
  const files: any[] = []
  const queue = [rootId]

  while (queue.length) {
    const batch = queue.splice(0, 5) // 5 dossiers en parallèle
    const results = await Promise.all(
      batch.map(async (id) => ({ id, children: await listChildren(event, ownerId, id) }))
    )
    for (const { id, children } of results) {
      const parent = folders.get(id)!
      const path = [...parent.path, id]
      for (const c of children) {
        if (c.mimeType === FOLDER) {
          if (!folders.has(c.id)) {
            folders.set(c.id, { name: c.name, parent: id, path, created: c.createdTime })
            queue.push(c.id)
          }
        } else {
          files.push({ ...c, parent: id, path })
        }
      }
    }
  }

  const withAudio = new Set<string>([rootId])
  for (const f of files) for (const p of f.path) withAudio.add(p)

  const rows: any[] = []
  for (const [id, f] of folders) {
    if (!withAudio.has(id)) continue
    rows.push({
      library_id: libraryId, owner_id: ownerId, drive_id: id, parent_id: f.parent,
      name: f.name, mime_type: FOLDER, is_folder: true, created_time: f.created ?? null,
      size: null, path_ids: f.path
    })
  }
  for (const f of files) {
    rows.push({
      library_id: libraryId, owner_id: ownerId, drive_id: f.id, parent_id: f.parent,
      name: f.name, mime_type: f.mimeType, is_folder: false, created_time: f.createdTime ?? null,
      size: f.size ? Number(f.size) : null, path_ids: f.path
    })
  }

  const db = serverSupabaseServiceRole(event)
  await db.from('library_items').delete().eq('library_id', libraryId)
  for (let i = 0; i < rows.length; i += 500) {
    const { error } = await db.from('library_items').insert(rows.slice(i, i + 500))
    if (error) throw createError({ statusCode: 500, message: error.message })
  }
  await db.from('libraries').update({ last_scan: new Date().toISOString(), name: rootName }).eq('id', libraryId)

  return { folders: rows.filter((r) => r.is_folder).length, files: files.length }
}
</file>

<file path="supabase/schema.sql">
-- AudioStream : schéma Supabase
-- À coller tel quel dans Supabase > SQL Editor > Run.
-- Toutes les tables ont RLS activé SANS policy : seul le serveur Nuxt
-- (clé service_role) peut y accéder. Le navigateur n'y touche jamais directement.

-- 1) Connexion Google Drive du propriétaire (refresh token chiffré côté serveur)
create table if not exists public.drive_connections (
  user_id           uuid primary key references auth.users(id) on delete cascade,
  refresh_token_enc text not null,
  updated_at        timestamptz not null default now()
);

-- 2) Bibliothèques : un dossier racine du Drive choisi par le propriétaire
create table if not exists public.libraries (
  id             uuid primary key default gen_random_uuid(),
  owner_id       uuid not null references auth.users(id) on delete cascade,
  root_folder_id text not null,
  name           text not null,
  last_scan      timestamptz,
  created_at     timestamptz not null default now(),
  unique (owner_id, root_folder_id)
);

-- 3) Index de la bibliothèque : sous-dossiers contenant de l'audio + fichiers audio
--    (c'est la "mini base de données" sélectionnée dans le Drive)
create table if not exists public.library_items (
  id           bigint generated always as identity primary key,
  library_id   uuid not null references public.libraries(id) on delete cascade,
  owner_id     uuid not null references auth.users(id) on delete cascade,
  drive_id     text not null,
  parent_id    text,
  name         text not null,
  mime_type    text,
  is_folder    boolean not null default false,
  created_time timestamptz,
  size         bigint,
  path_ids     text[] not null default '{}',  -- ids des dossiers ancêtres (racine -> parent)
  unique (library_id, drive_id)
);
create index if not exists library_items_library_idx on public.library_items (library_id);
create index if not exists library_items_owner_drive_idx on public.library_items (owner_id, drive_id);
create index if not exists library_items_path_idx on public.library_items using gin (path_ids);

-- 4) Liens de partage d'un sous-dossier (et de tout ce qu'il contient)
create table if not exists public.shares (
  token      text primary key
             default replace(gen_random_uuid()::text, '-', '') || replace(gen_random_uuid()::text, '-', ''),
  library_id uuid not null references public.libraries(id) on delete cascade,
  owner_id   uuid not null references auth.users(id) on delete cascade,
  folder_id  text not null,
  role       text not null default 'viewer' check (role in ('viewer', 'editor')),
  expires_at timestamptz,
  revoked    boolean not null default false,
  created_at timestamptz not null default now()
);
create index if not exists shares_library_idx on public.shares (library_id, folder_id);

alter table public.drive_connections enable row level security;
alter table public.libraries         enable row level security;
alter table public.library_items     enable row level security;
alter table public.shares            enable row level security;
</file>

