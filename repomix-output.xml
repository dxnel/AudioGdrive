:root {
  color-scheme: dark;
}

html,
body {
  background: #0e0f12;
  color: #edeef0;
}

body {
  font-family: 'Schibsted Grotesk', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  overscroll-behavior-y: none;
}

:focus-visible {
  outline: 2px solid #8b8cff;
  outline-offset: 2px;
}

::selection {
  background: rgba(139, 140, 255, 0.35);
}

/* Barre de progression / curseur de lecture */
input[type='range'].scrub {
  -webkit-appearance: none;
  appearance: none;
  background: transparent;
  width: 100%;
  height: 24px;
  cursor: pointer;
  margin: 0;
  --p: 0%;
}
.scrub::-webkit-slider-runnable-track {
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(to right, #edeef0 var(--p), rgba(255, 255, 255, 0.16) var(--p));
}
.scrub::-moz-range-track {
  height: 4px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.16);
}
.scrub::-moz-range-progress {
  height: 4px;
  border-radius: 999px;
  background: #edeef0;
}
.scrub::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  margin-top: -4px;
  border-radius: 50%;
  background: #fff;
  opacity: 0;
  transition: opacity 0.15s;
}
.scrub::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border: 0;
  border-radius: 50%;
  background: #fff;
  opacity: 0;
  transition: opacity 0.15s;
}
.scrub:hover::-webkit-slider-thumb,
.scrub:focus-visible::-webkit-slider-thumb,
.scrub.scrub-lg::-webkit-slider-thumb {
  opacity: 1;
}
.scrub:hover::-moz-range-thumb,
.scrub:focus-visible::-moz-range-thumb,
.scrub.scrub-lg::-moz-range-thumb {
  opacity: 1;
}
.scrub:focus-visible {
  outline-offset: 0;
}

/* Égaliseur de la piste en lecture */
@keyframes eq {
  0%, 100% { transform: scaleY(0.35); }
  50% { transform: scaleY(1); }
}
.eq-bar {
  transform-origin: 50% 100%;
  animation: eq 0.9s ease-in-out infinite;
}
.eq-bar:nth-child(2) { animation-delay: -0.3s; animation-duration: 0.7s; }
.eq-bar:nth-child(3) { animation-delay: -0.6s; animation-duration: 1.1s; }

/* Seul moment animé « décoratif » : la forme d'onde de l'écran de connexion */
@keyframes bar-rise {
  from { transform: scaleY(0.12); opacity: 0; }
  to { transform: scaleY(1); opacity: 1; }
}
.bar-rise {
  transform-origin: 50% 100%;
  animation: bar-rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.scrollbar-none {
  scrollbar-width: none;
}
.scrollbar-none::-webkit-scrollbar {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
