# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=eyJ...            # clé "anon" / publishable
SUPABASE_SERVICE_KEY=eyJ...    # clé "service_role" (SECRÈTE, serveur uniquement)

# Google Cloud > APIs & Services > Credentials > OAuth client (type "Web")
# (les mêmes que ceux collés dans Supabase > Authentication > Providers > Google)
NUXT_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
NUXT_GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Clé de chiffrement des refresh tokens (32 octets en base64)
# Génère-la avec :  openssl rand -base64 32
NUXT_ENCRYPTION_KEY=
